# ved.ai Environment Variables Template
# PostgreSQL connection string (Supabase / local PostgreSQL / RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ved_ai?schema=public"

# Supabase direct/pooled example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session & Security Settings
SESSION_SECRET="your-cryptographically-secure-secret-32-chars-minimum"
NODE_ENV="development"

# Supabase Client Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# VedThinkingEngine Model Configuration (Gemini 2.0 Flash Thinking / DeepSeek-R1)
VITE_THINKING_MODEL_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
VITE_THINKING_MODEL_API_KEY="your-openrouter-or-gemini-api-key"
VITE_THINKING_MODEL_NAME="google/gemini-2.0-flash-thinking-exp:free"
